# Application
APP_NAME=PdM-Nuclear
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
AES_ENCRYPTION_KEY=change-me-32-byte-key-for-aes256!!

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=pdm-nuclear-dev-token
INFLUXDB_ORG=pdm-nuclear
INFLUXDB_BUCKET=sensor_data
INFLUXDB_RETENTION=90d

# Anomaly detection
ANOMALY_THRESHOLD_K=3.0
THRESHOLD_UPDATE_INTERVAL_HOURS=24
LSTM_INPUT_SIZE=64
LSTM_ENCODER_LAYERS=32,16
LSTM_DECODER_LAYERS=32,64
MODEL_PATH=data/models/lstm_autoencoder.h5

# Windowing (seconds)
WINDOW_NEUTRON_FLUX=10
WINDOW_TEMPERATURE=3600

# OPC-UA / Modbus (optional for dev)
OPCUA_ENDPOINT=opc.tcp://localhost:4840
MODBUS_HOST=localhost
MODBUS_PORT=502

# Backup
BACKUP_INTERVAL_HOURS=24
BACKUP_PATH=data/backups
